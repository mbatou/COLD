# Supabase
# The browser client REQUIRES the NEXT_PUBLIC_* names below.
# The Vercel Supabase integration may also inject SUPABASE_URL / SUPABASE_ANON_KEY
# (server-only) — the server client and middleware fall back to those, but the
# browser bundle still needs the NEXT_PUBLIC_* pair set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-side only — never expose to the client)
# Either name works; ANTHROPIC_API_KEY takes precedence.
ANTHROPIC_API_KEY=
ANTHROPIC_SECRET_KEY=
